# Copy this file to .env for local use. Never commit .env.
# Prefer secret-file paths or Vault/KMS identifiers over raw secret material.

# PostgreSQL connection. Keep production credentials outside this file.
OR_DATABASE_URL=postgresql://onionroute@localhost:5432/onionroute

# Signing service: the key ID may be a Vault/KMS identifier; the seed is read
# from a protected file instead of being stored directly in the environment.
OR_ONLINE_SIGNING_KEY_ID=replace-with-vault-or-kms-key-id
OR_ONLINE_SIGNING_SEED_FILE=/run/secrets/onionroute-online-signing-seed
OR_SIGNED_TRUST_BUNDLE_FILE=/run/secrets/onionroute-signed-trust-bundle.json

# Real-onion staging inputs. These variables contain paths, not key contents.
OR_STAGING_TLS_CERT_FILE=/absolute/path/to/staging-tls-cert.pem
OR_STAGING_TLS_KEY_FILE=/absolute/path/to/staging-tls-key.pem
OR_STAGING_TOKEN_BUNDLE_FILE=/absolute/path/to/signed-verifier-bundle.json
