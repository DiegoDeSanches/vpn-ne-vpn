*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local Vault and cloud credentials
.vault-token
vault-token
vault-password*
.vault-pass*
credentials.json
application_default_credentials.json
service-account*.json
