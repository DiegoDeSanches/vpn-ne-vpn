<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>OnionRoute.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OnionRouteLocalPrototype)' == 'true'">
    <!-- Explicit opt-in only. Release builds keep the signed Windows-service verifier. -->
    <DefineConstants>$(DefineConstants);ONIONROUTE_LOCAL_PROTOTYPE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240923002" />
    <PackageReference Include="Google.Protobuf" Version="3.28.2" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0" PrivateAssets="All" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <Protobuf Include="..\..\..\crates\ipc\schema\onionroute\desktop\ipc\v1\ipc.proto"
              GrpcServices="None" Access="Public" />
  </ItemGroup>

  <!-- WinUI compiles the XAML code-behind before the regular C# BeforeCompile
       hook used by Grpc.Tools. Generate the IPC bindings before that pass. -->
  <Target Name="GenerateProtobufBeforeXaml"
          BeforeTargets="MarkupCompilePass1"
          DependsOnTargets="Protobuf_Compile" />
</Project>
