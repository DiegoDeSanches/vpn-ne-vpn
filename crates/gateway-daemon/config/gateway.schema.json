{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onionroute.invalid/schemas/gateway-config-v1.json",
  "title": "OnionRoute private exit gateway configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["gateway_id", "onion_listener", "management_listener", "tls", "dns", "acl", "limits", "privacy_events"],
  "properties": {
    "gateway_id": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$"},
    "onion_listener": {"type": "string", "description": "Must be a loopback socket address."},
    "management_listener": {"type": "string", "description": "Must be a distinct loopback socket address."},
    "drain_grace_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate_chain", "private_key"],
      "properties": {
        "certificate_chain": {"type": "string", "minLength": 1},
        "private_key": {"type": "string", "minLength": 1}
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstreams"],
      "properties": {
        "upstreams": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}},
        "query_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 30000},
        "max_response_bytes": {"type": "integer", "minimum": 512, "maximum": 65535},
        "max_records": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_cname_depth": {"type": "integer", "minimum": 1, "maximum": 16},
        "max_addresses": {"type": "integer", "minimum": 1, "maximum": 64},
        "revalidate": {"type": "boolean"}
      }
    },
    "acl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blocked_ports": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
        "management_networks": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
        "emergency_deny_networks": {"type": "array", "maxItems": 256, "items": {"type": "string"}},
        "emergency_deny_host_suffixes": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 253}},
        "cloud_metadata_ips": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_connections": {"type": "integer", "minimum": 1, "maximum": 65536},
        "listen_backlog": {"type": "integer", "minimum": 1, "maximum": 65535},
        "max_sessions": {"type": "integer", "minimum": 1, "maximum": 65536},
        "max_token_states": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_sessions_per_token": {"type": "integer", "minimum": 1},
        "max_streams_global": {"type": "integer", "minimum": 1},
        "max_streams_per_session": {"type": "integer", "minimum": 1, "maximum": 4096},
        "max_streams_per_token": {"type": "integer", "minimum": 1},
        "connection_rate_per_second": {"type": "integer", "minimum": 1},
        "connection_rate_burst": {"type": "integer", "minimum": 1},
        "bandwidth_bytes_per_second": {"type": "integer", "minimum": 1},
        "bandwidth_burst_bytes": {"type": "integer", "minimum": 1},
        "token_byte_quota": {"type": "integer", "minimum": 1},
        "max_frame_bytes": {"const": 65536},
        "max_data_bytes": {"type": "integer", "minimum": 1, "maximum": 32768},
        "max_token_bytes": {"type": "integer", "minimum": 1, "maximum": 4096},
        "max_proof_bytes": {"type": "integer", "minimum": 1, "maximum": 4096},
        "max_stream_window": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "initial_stream_window": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "outbound_event_queue": {"type": "integer", "minimum": 1, "maximum": 16384},
        "handshake_timeout_ms": {"type": "integer", "minimum": 1},
        "auth_timeout_ms": {"type": "integer", "minimum": 1},
        "connect_timeout_ms": {"type": "integer", "minimum": 1},
        "io_timeout_ms": {"type": "integer", "minimum": 1},
        "session_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "scan_window_seconds": {"type": "integer", "minimum": 1},
        "scan_distinct_destination_limit": {"type": "integer", "minimum": 1},
        "circuit_failure_threshold": {"type": "integer", "minimum": 1},
        "circuit_cooldown_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "privacy_events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "capacity": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "coarse_bucket_seconds": {"type": "integer", "minimum": 60, "maximum": 3600}
      }
    }
  }
}
