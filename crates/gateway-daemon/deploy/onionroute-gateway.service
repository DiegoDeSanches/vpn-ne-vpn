[Unit]
Description=OnionRoute private exit gateway
After=network-online.target onionroute-tor.service
Wants=network-online.target
Requires=onionroute-egress-netns.service onionroute-tor.service

[Service]
Type=simple
User=onionroute-gateway
Group=onionroute-gateway
ExecStart=/usr/local/bin/onionroute-gateway-daemon /etc/onionroute-gateway/gateway.json
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=330s
KillSignal=SIGTERM
NetworkNamespacePath=/run/netns/onionroute-egress

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
TasksMax=2048
MemoryMax=1G
LimitNOFILE=65536
RuntimeDirectory=onionroute-gateway
RuntimeDirectoryMode=0750
ReadWritePaths=/run/onionroute-gateway
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
