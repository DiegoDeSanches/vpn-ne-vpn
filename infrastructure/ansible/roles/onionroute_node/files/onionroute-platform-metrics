#!/usr/bin/python3
"""Write a closed, label-free platform metric set for node_exporter."""

from datetime import datetime, timezone
import math
import os
from pathlib import Path
import re
import socket
import subprocess


DESTINATION = Path("/var/lib/prometheus/node-exporter/onionroute.prom")
TOR_SOCKET = "/run/tor/control"
TOR_COOKIE = Path("/run/tor/control.authcookie")
MAX_COMMAND_OUTPUT = 16_384


def command(argv):
    try:
        result = subprocess.run(
            argv,
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=3,
            env={**os.environ, "LC_ALL": "C"},
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    if result.returncode != 0 or len(result.stdout) > MAX_COMMAND_OUTPUT:
        return ""
    return result.stdout


def parse_tor_bootstrap(response):
    match = re.search(r"(?:^|[ ])PROGRESS=([0-9]{1,3})(?:[ ]|$)", response)
    if not match:
        return 0
    return min(100, int(match.group(1)))


def tor_bootstrap():
    if not TOR_COOKIE.is_file() or TOR_COOKIE.stat().st_size != 32:
        return 0
    cookie = TOR_COOKIE.read_bytes().hex()
    request = f"AUTHENTICATE {cookie}\r\nGETINFO status/bootstrap-phase\r\nQUIT\r\n".encode("ascii")
    response = bytearray()
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as control:
            control.settimeout(2)
            control.connect(TOR_SOCKET)
            control.sendall(request)
            while len(response) <= MAX_COMMAND_OUTPUT:
                chunk = control.recv(4096)
                if not chunk:
                    break
                response.extend(chunk)
    except (OSError, ValueError):
        return 0
    if len(response) > MAX_COMMAND_OUTPUT:
        return 0
    return parse_tor_bootstrap(response.decode("ascii", "replace"))


def clock_drift():
    output = command(["/usr/bin/chronyc", "tracking"])
    match = re.search(r"^Last offset\s*:\s*([+-]?[0-9.eE+-]+)\s+seconds$", output, re.MULTILINE)
    if not match:
        return 999999.0
    try:
        value = float(match.group(1))
    except ValueError:
        return 999999.0
    return value if math.isfinite(value) else 999999.0


def parse_expiry(value):
    try:
        normalized = value.strip().replace("Z", "+00:00")
        expiry = datetime.fromisoformat(normalized)
        if expiry.tzinfo is None:
            return None
        return int((expiry.astimezone(timezone.utc) - datetime.now(timezone.utc)).total_seconds())
    except (ValueError, OverflowError):
        return None


def key_expiry():
    secret_root = Path("/run/onionroute/secrets/app")
    values = []
    for certificate in (secret_root / "gateway-identity.crt", secret_root / "mtls.crt"):
        if certificate.is_file() and certificate.stat().st_size <= 64 * 1024:
            output = command([
                "/usr/bin/openssl", "x509", "-in", str(certificate),
                "-noout", "-enddate", "-dateopt", "iso_8601",
            ])
            if output.startswith("notAfter="):
                value = parse_expiry(output.split("=", 1)[1])
                if value is not None:
                    values.append(value)
    expiry_files = sorted(secret_root.glob("*.expires-at"))
    if len(expiry_files) > 4:
        return 0
    for expiry_file in expiry_files:
        if expiry_file.stat().st_size > 128:
            return 0
        value = parse_expiry(expiry_file.read_text(encoding="ascii"))
        if value is None:
            return 0
        values.append(value)
    return min(values) if values else 0


def main():
    onion_available = int(
        Path("/run/onionroute/secrets/onion/data/hostname").is_file()
        and Path("/run/onionroute/secrets/onion/management/hostname").is_file()
    )
    values = {
        "onionroute_tor_bootstrap_percent": tor_bootstrap(),
        "onionroute_onion_available": onion_available,
        "onionroute_clock_drift_seconds": clock_drift(),
        "onionroute_key_expiry_seconds": key_expiry(),
    }
    temporary = DESTINATION.with_suffix(".prom.tmp")
    with temporary.open("w", encoding="ascii") as stream:
        for name, value in values.items():
            stream.write(f"{name} {value}\n")
    os.chmod(temporary, 0o644)
    os.replace(temporary, DESTINATION)


if __name__ == "__main__":
    main()
