#!/bin/sh
set -eu

path=${1:?secret path is required}
timeout=${2:-90}
case "$path" in
  /run/onionroute/secrets/app/*|/run/onionroute/secrets/onion/data/*|/run/onionroute/secrets/onion/management/*) ;;
  *) echo "refusing unexpected secret path" >&2; exit 64 ;;
esac

elapsed=0
while [ "$elapsed" -lt "$timeout" ]; do
  if [ -s "$path" ]; then
    exit 0
  fi
  sleep 1
  elapsed=$((elapsed + 1))
done

echo "required secret was not delivered" >&2
exit 1
