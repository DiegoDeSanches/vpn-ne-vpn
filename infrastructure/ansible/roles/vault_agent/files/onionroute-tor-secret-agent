#!/bin/sh
set -eu
umask 077

: "${ONIONROUTE_CLOUD:?missing cloud identity type}"
: "${ONIONROUTE_VAULT_ADDR:?missing Vault address}"
: "${ONIONROUTE_VAULT_AUTH_ROLE:?missing Vault auth role}"
: "${ONIONROUTE_SECRET_SCOPE:?missing Vault secret scope}"
: "${ONIONROUTE_NODE_ID:?missing node ID}"

case "$ONIONROUTE_VAULT_ADDR" in https://*) ;; *) exit 64 ;; esac
case "$ONIONROUTE_VAULT_AUTH_ROLE" in ''|*[!A-Za-z0-9._-]*) exit 64 ;; esac
case "$ONIONROUTE_SECRET_SCOPE" in kv/data/nodes/*) ;; *) exit 64 ;; esac
test "$ONIONROUTE_VAULT_AUTH_ROLE" = "$ONIONROUTE_NODE_ID"
test "$ONIONROUTE_SECRET_SCOPE" = "kv/data/nodes/$ONIONROUTE_NODE_ID"

case "$ONIONROUTE_CLOUD" in
  aws) auth_type=aws; identity_type=iam ;;
  gcp) auth_type=gcp; identity_type=gce ;;
  *) exit 64 ;;
esac

tor_auth_role="${ONIONROUTE_VAULT_AUTH_ROLE}-onion"
config=/run/onionroute/vault-agent-onion.hcl
install -d -m 0700 /run/onionroute/secrets/onion/data/authorized_clients
install -d -m 0700 /run/onionroute/secrets/onion/management/authorized_clients

cat > "$config" <<EOF
auto_auth {
  method "$auth_type" {
    mount_path = "auth/$auth_type"
    config = {
      type = "$identity_type"
      role = "$tor_auth_role"
    }
  }
}
template_config {
  exit_on_retry_failure         = true
  static_secret_render_interval = "5m"
}
vault {
  retry { num_retries = 5 }
}
EOF

write_onion_file() {
  secret_name=$1
  field=$2
  destination=$3
  transform=$4
  cat >> "$config" <<EOF
template {
  destination = "/run/onionroute/secrets/onion/$destination"
  perms       = "0600"
  contents    = <<EOT
{{- with secret "$ONIONROUTE_SECRET_SCOPE/$secret_name" -}}
{{ $transform .Data.data.$field }}
{{- end -}}
EOT
}
EOF
}

for service in data management; do
  if [ "$service" = data ]; then secret=onion-service; else secret=onion-management; fi
  write_onion_file "$secret" hs_ed25519_secret_key_b64 "$service/hs_ed25519_secret_key" base64Decode
  write_onion_file "$secret" hs_ed25519_public_key_b64 "$service/hs_ed25519_public_key" base64Decode
  write_onion_file "$secret" hostname "$service/hostname" ""
  write_onion_file "$secret" authorized_client "$service/authorized_clients/operator.auth" ""
done

if [ "${ONIONROUTE_ROLE:-}" = monitoring ]; then
  write_onion_file monitoring-onion-client client_auth "client-auth/fleet.auth_private" ""
fi

export VAULT_ADDR=$ONIONROUTE_VAULT_ADDR
exec /usr/bin/vault agent -config="$config"
