[Unit]
Description=Load bounded non-secret OnionRoute node inventory from workload metadata
After=nftables.service network-online.target
Requires=nftables.service
Wants=network-online.target
Before=onionroute-vault-agent.service onionroute-tor-secret-agent.service

[Service]
Type=oneshot
User=onionroute-bootstrap
Group=onionroute-bootstrap
ExecStart=/usr/local/libexec/onionroute-bootstrap
RemainAfterExit=yes
RuntimeDirectory=onionroute-bootstrap
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
IPAddressDeny=any
IPAddressAllow=169.254.169.254/32
ReadWritePaths=/run/onionroute-bootstrap
StandardOutput=null
StandardError=null

[Install]
WantedBy=onionroute-node.target

