[Unit]
Description=OnionRoute workload-identity secret delivery
After=network-online.target nftables.service onionroute-bootstrap.service
Wants=network-online.target
Requires=nftables.service onionroute-bootstrap.service
ConditionPathExists=/run/onionroute-bootstrap/node.env

[Service]
Type=simple
User=onionroute-vault
Group={{ onionroute_service_group }}
EnvironmentFile=/run/onionroute-bootstrap/node.env
ExecStart=/usr/local/libexec/onionroute-vault-agent
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=300
StartLimitBurst=5
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
RuntimeDirectory=onionroute/secrets/app
RuntimeDirectoryMode=0750
ReadWritePaths=/run/onionroute
StandardOutput=null
StandardError=null

[Install]
WantedBy=onionroute-node.target
